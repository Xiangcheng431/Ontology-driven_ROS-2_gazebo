###  http://www.semanticweb.org/lixiangcheng/CASK+CRO-abox#BobcatAcceptedElement
:BobcatAcceptedElement rdf:type owl:NamedIndividual ,
                                VDI3682:Product ;
                       DINEN:has_Data_Element :BobcatPayload_Property ,
                                              :Soil_Assurance_Property .


###  http://www.semanticweb.org/lixiangcheng/CASK+CRO-abox#BobcatDiggingDepth_ID
:BobcatDiggingDepth_ID rdf:type owl:NamedIndividual ,
                                DINEN:Instance_Description ;
                       DINEN:Instance_Description_has_Type :DiggingDepth_TD ;
                       DINEN:Expression_Goal "Assurance" ;
                       DINEN:Logic_Interpretation "<=" ;
                       DINEN:Value 5 .


###  http://www.semanticweb.org/lixiangcheng/CASK+CRO-abox#BobcatDiggingDepth_Property
:BobcatDiggingDepth_Property rdf:type owl:NamedIndividual ,
