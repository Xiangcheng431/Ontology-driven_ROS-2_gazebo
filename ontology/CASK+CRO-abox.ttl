                             DINEN:has_Type_Description :DiggingDepth_TD .


###  http://www.semanticweb.org/lixiangcheng/CASK+CRO-abox#BobcatExcavatingSkillInterface_01
:BobcatExcavatingSkillInterface_01 rdf:type owl:NamedIndividual ,
                                            css:SkillInterface ;
                                   :hasROSEndpoint "/bobcat_01/excavating" ;
                                   :hasROSInterfaceType "action" ;
                                   :hasROSMessageType "ros_interfaces/action/ExecuteSkill" .


###  http://www.semanticweb.org/lixiangcheng/CASK+CRO-abox#BobcatExcavatingSkill_01
:BobcatExcavatingSkill_01 rdf:type owl:NamedIndividual ,
                                   css:Skill ;
                          css:accessibleThrough :BobcatExcavatingSkillInterface_01 .


###  http://www.semanticweb.org/lixiangcheng/CASK+CRO-abox#BobcatExcavating_01
:BobcatExcavating_01 rdf:type owl:NamedIndividual ,
                              VDI3682:ProcessOperator ,
                              CASK:ProvidedCapability ;
                     VDI3682:hasInput :BobcatAcceptedElement ;
                     VDI3682:hasOutput :BobcatProducedElement ;
                     css:isRealizedBySkill :BobcatExcavatingSkill_01 ;
                     css:isSpecifiedBy :Excavating_Assurance_Property .


