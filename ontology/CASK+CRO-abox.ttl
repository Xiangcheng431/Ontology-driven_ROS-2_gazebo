          ns1:gazeboModelName "crane" ;
          ns1:hasInitialPose ns1:initial_crane .


###  http://www.semanticweb.org/lixiangcheng/CASK+CRO-abox#DeliveryHeightHoldDuration_TD
:DeliveryHeightHoldDuration_TD rdf:type owl:NamedIndividual ,
                                        DINEN:Real ,
                                        DINEN:Type_Description ;
                               DINEN:Code "deliveryHeightHoldDuration" ;
                               DINEN:Definition "Continuous simulated seconds at output product XY/yaw and required lifting world Z, before final lowering. Final output Z is the released height, not the hold height." ;
                               DINEN:Preferred_Name "Delivery height continuous hold duration" ;
                               DINEN:Unit_of_Measure "s" ;
                               DINEN:Version_Number 1 .


