abox:Truck_01 a scene:RobotEntity ;
    scene:gazeboModelName "truck" ;
    scene:hasInitialPose scene:initial_truck .

scene:SceneSupplement a owl:Ontology ;
    rdfs:comment "IOC conversion supplement only. Existing launch, motion, ABox and runtime World Model are unchanged. Initial poses, task states, declared defaults and launch overrides have distinct records. Do not interpret this snapshot as live state." .

scene:TimberTransfer a scene:MaterialTransferScenario ;
    rdfs:comment "Simulation defaults: 100 kg palletized timber. Pickup behind Kali; storage to the right. Coordinates are scene facts, not control code. Adjust here for a different scene." ;
    scene:carryHeight 0.75 ;
    scene:delivery scene:TimberIntermediateStorage ;
    scene:gazeboModelName "timber_01" ;
    scene:massKg 100.0 ;
    scene:material "Timber" ;
    scene:mobileCraneWorkPose scene:TimberMobileCraneWork ;
    scene:pickup scene:TimberPickup ;
    scene:pickupApproachDistance 2.5e0 .

