<?xml version="1.0"?>
<sdf version="1.7">
  <model name="timber_01">
    <link name="cargo_link">
      <inertial><pose>0 0 0.22 0 0 0</pose><mass>100</mass><inertia><ixx>26.6667</ixx><iyy>17.3333</iyy><izz>33.3333</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="deck"><pose>0 0 .125 0 0 0</pose><geometry><box><size>1.2 1.0 .05</size></box></geometry><surface><friction><ode><mu>.9</mu><mu2>.9</mu2></ode></friction></surface></collision>
      <visual name="deck"><pose>0 0 .125 0 0 0</pose><geometry><box><size>1.2 1.0 .05</size></box></geometry><material><ambient>.4 .24 .1 1</ambient><diffuse>.4 .24 .1 1</diffuse></material></visual>
      <collision name="runner_left"><pose>0 .48 -.15 0 0 0</pose><geometry><box><size>1.2 .10 .5</size></box></geometry></collision>
