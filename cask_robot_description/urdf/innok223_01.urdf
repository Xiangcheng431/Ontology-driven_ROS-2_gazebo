      <wheel_separation>0.58</wheel_separation>
      <wheel_radius>0.16</wheel_radius>
      <topic>/innok223/cmd_vel</topic>
      <odom_topic>/innok223/odom</odom_topic>
      <tf_topic>/innok223/odom_tf</tf_topic>
      <frame_id>innok223_odom</frame_id>
      <child_frame_id>innok223_base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <min_linear_velocity>-0.35</min_linear_velocity>
      <max_linear_velocity>0.7</max_linear_velocity>
      <min_angular_velocity>-0.55</min_angular_velocity>
      <max_angular_velocity>0.55</max_angular_velocity>
      <min_linear_acceleration>-0.45</min_linear_acceleration>
      <max_linear_acceleration>0.45</max_linear_acceleration>
      <min_angular_acceleration>-0.7</min_angular_acceleration>
      <max_angular_acceleration>0.7</max_angular_acceleration>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="ignition::gazebo::systems::JointStatePublisher" filename="ignition-gazebo-joint-state-publisher-system">
      <topic>/innok223/joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="ignition::gazebo::systems::PosePublisher" filename="ignition-gazebo-pose-publisher-system">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
      <publish_model_pose>true</publish_model_pose>
    </plugin>
  </gazebo>
  <material name="coupler_yellow">
    <color rgba="0.98 0.74 0.15 1" />
  </material>
  <gazebo>
    <plugin name="ignition::gazebo::systems::JointPositionController" filename="ignition-gazebo-joint-position-controller-system">
      <joint_name>innok223_caster_swivel_joint</joint_name>
      <topic>/innok223/steering_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>8</p_gain>
      <cmd_max>0.8</cmd_max><cmd_min>-0.8</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
  </gazebo>
</robot>
