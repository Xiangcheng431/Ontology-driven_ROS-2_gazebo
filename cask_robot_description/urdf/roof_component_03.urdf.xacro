<?xml version="1.0"?>

<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="roof_component_03">

  <material name="roof_component_blue">
    <color rgba="0.15 0.45 0.80 1.0"/>
  </material>

  <link name="roof_component_03_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="1.20 0.60 0.12"/>
      </geometry>

      <material name="roof_component_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="1.20 0.60 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="50.0"/>

      <inertia
        ixx="1.518"
        ixy="0.0"
        ixz="0.0"
        iyy="6.018"
        iyz="0.0"
        izz="7.500"/>
    </inertial>

  </link>

</robot>